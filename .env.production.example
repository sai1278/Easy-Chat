# ==============================================================================
# Easy Chat - Production Environment Variables Template
# ==============================================================================
# COPY THIS FILE TO .env.production OR .env ON THE PRODUCTION HOST:
#   cp .env.production.example .env.production
#
# SECURITY WARNING:
# - NEVER commit .env, .env.production, or any real secret values to Git.
# - Generate cryptographically secure random secrets using openssl:
#     JWT_SECRET:       openssl rand -hex 32
#     POSTGRES_PASSWORD: openssl rand -base64 24
#     REDIS_PASSWORD:    openssl rand -base64 24
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DOMAIN SETTINGS (REQUIRED)
# ------------------------------------------------------------------------------
# Production environment identifier
APP_ENV=production

# Public API domain name configured in DNS pointing to Easy Chat Elastic IP
DOMAIN_NAME=api.easychat.com

# Administrator contact email for Let's Encrypt TLS certificate renewal warnings
CERTBOT_EMAIL=admin@easychat.com

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY TOKENS (REQUIRED - CRITICAL)
# ------------------------------------------------------------------------------
# Mandatory HMAC-SHA256 signing secret for JWT user authentication.
# MUST BE AT LEAST 32 BYTES (e.g., generate with `openssl rand -hex 32`)
# DO NOT LEAVE EMPTY OR USE DEFAULT VALUE.
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_64_CHAR_HEX_SECRET

# ------------------------------------------------------------------------------
# 3. POSTGRESQL / POSTGIS DATABASE SETTINGS (REQUIRED)
# ------------------------------------------------------------------------------
POSTGRES_USER=easychat_admin
POSTGRES_DB=easychat_production

# Secure password for PostgreSQL database.
# Generate with `openssl rand -base64 24`
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_POSTGRES_PASSWORD

# ------------------------------------------------------------------------------
# 4. REDIS CACHE & IN-MEMORY STORE SETTINGS (REQUIRED)
# ------------------------------------------------------------------------------
# Secure password for Redis cache authentication (--requirepass).
# Generate with `openssl rand -base64 24`
REDIS_PASSWORD=REPLACE_WITH_SECURE_REDIS_PASSWORD

# ------------------------------------------------------------------------------
# 5. AWS S3 STORAGE & INFRASTRUCTURE SETTINGS (REQUIRED)
# ------------------------------------------------------------------------------
# Target AWS region
AWS_REGION=us-east-1

# S3 bucket name for encrypted media storage.
# MUST MATCH the Terraform output 's3_media_bucket_name'.
S3_BUCKET=easychat-media-production-storage

# ------------------------------------------------------------------------------
# 6. KAFKA SETTINGS (OPTIONAL / DEFAULTS CONFIGURED)
# ------------------------------------------------------------------------------
# JVM Heap memory allocated to Kafka KRaft container
KAFKA_HEAP_OPTS=-Xmx256M -Xms256M
