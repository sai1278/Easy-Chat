# postgresql.conf.template
# Production PostgreSQL Configuration Template
# Optimized for Nearby Connect: SSD storage, high write throughput, and volatile session partitions.

# =====================================================
# 1. CONNECTIONS AND BINDINGS
# =====================================================
listen_addresses = '*'
max_connections = 500                  # Connect limit (Scale via PgBouncer in transaction mode)
superuser_reserved_connections = 5

# =====================================================
# 2. MEMORY CONFIGURATION (Tuned for 16GB System RAM base)
# =====================================================
shared_buffers = 4GB                   # 25% of system memory
work_mem = 32MB                        # Temp buffer space for complex sort operations per connection
maintenance_work_mem = 1GB             # Buffer space for index creation, autovacuum runs
temp_buffers = 16MB

# =====================================================
# 3. WRITE-AHEAD LOG (WAL) & ARCHIVING
# =====================================================
wal_level = replica                    # Supports physical replication and WAL archiving
fsync = on
synchronous_commit = off               # Off for throughput; allows 1 WAL flush cycle lag (accepted for ephemeral data)
checkpoint_timeout = 15min             # Less frequent checkpoint writes
max_wal_size = 8GB
min_wal_size = 2GB
checkpoint_completion_target = 0.9     # Spread checkpoints out
archive_mode = on
archive_command = 'pgbackrest --stanza=nearby_db archive-push %p' # Placeholder for continuous WAL archiving

# =====================================================
# 4. QUERY PLANNER CONFIGURATION (Optimized for SSDs)
# =====================================================
random_page_cost = 1.1                 # Assumes NVMe/SSD storage
effective_cache_size = 12GB            # Estimated cache size (OS cache + shared_buffers)
effective_io_concurrency = 200          # Prefetching parallelism for SSD arrays

# =====================================================
# 5. AUTOMATIC VACUUM SETTINGS (Tuned for highly volatile rows)
# =====================================================
autovacuum = on
autovacuum_max_workers = 5
autovacuum_vacuum_scale_factor = 0.05  # Trigger vacuum when 5% of rows are updated/deleted
autovacuum_analyze_scale_factor = 0.02 # Trigger analyze when 2% of rows are updated/deleted
autovacuum_vacuum_cost_delay = 2ms     # Prevent autovacuum from choking server I/O

# =====================================================
# 6. OBSERVABILITY AND SYSTEM LOGGING
# =====================================================
log_destination = 'csvlog'
logging_collector = on
log_directory = 'log'
log_filename = 'postgresql-%Y-%m-%d_%H%M%S.log'
log_min_messages = warning
log_min_error_statement = error
log_min_duration_statement = 250        # Log all queries running longer than 250ms (Slow query logger)
log_line_prefix = '%m [%p] %q%u@%d '   # Format prefixes: timestamp, PID, user, database
log_lock_waits = on                     # Log lock requests waiting longer than deadlock_timeout

