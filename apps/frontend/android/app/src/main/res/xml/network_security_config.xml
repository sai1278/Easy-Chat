<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production Base Config: Strict HTTPS enforcement with System CA Trust -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Development & Local Testing Exceptions Only -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.1.2</domain>
        <domain includeSubdomains="true">192.168.31.60</domain>
    </domain-config>
</network-security-config>
